# Payload of the e2e module, packaged as an OCM resource. The deployer
# interpolates ${...} per component instance before applying it, so nothing
# here names the installation: the Module CR the admin applies decides that.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${module + "-" + component}
  namespace: ${targetNamespace}
spec:
  replicas: ${values.replicas}
  selector:
    matchLabels:
      app: ${module + "-" + component}
  template:
    metadata:
      labels:
        app: ${module + "-" + component}
    spec:
      containers:
        - name: app
          image: ${values.image}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          envFrom:
            # The ConfigMap the deployer generates for this instance.
            - configMapRef:
                name: ${configMap}
          env:
            - name: GREETING
              value: ${values.greeting}
            # The kubeconfig the deployer minted for this module, scoped to
            # the module's own kcp workspace.
            - name: KUBECONFIG_PATH
              value: /etc/kcp/kubeconfig
            - name: SECRET_NAMESPACE
              value: ${values.secretNamespace}
            - name: SECRET_NAME
              value: ${values.secretName}
          volumeMounts:
            - name: kcp
              mountPath: /etc/kcp
              readOnly: true
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
      volumes:
        - name: kcp
          secret:
            secretName: ${kubeconfigSecrets.kcp}
---
apiVersion: v1
kind: Service
metadata:
  name: ${module + "-" + component}
  namespace: ${targetNamespace}
spec:
  type: NodePort
  selector:
    app: ${module + "-" + component}
  ports:
    - name: http
      port: 8080
      targetPort: http
      nodePort: ${values.nodePort}
